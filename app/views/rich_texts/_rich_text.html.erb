<div id="<%= dom_id rich_text %>">
  <!-- Content Preview -->
  <div class="card mb-6">
    <div class="card-body">
      <% if rich_text.html? %>
        <%= render "rich_texts/html_security_notice", rich_text: rich_text %>
      <% end %>
      <div class="prose prose-sm max-w-none">
        <% if rich_text.plaintext? %>
          <%= rich_text.text %>
        <% else %>
          <% sanitized_html = sanitize(rich_text.text) %>
          <% if rich_text.text.present? && sanitized_html.blank? %>
            <p class="text-sm italic text-neutral-500">No visible content remains in the sanitized preview.</p>
          <% else %>
            <%= sanitized_html %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "contents/show_details", content: rich_text do %>
    <!-- Render As Field -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <dt class="text-body font-medium text-neutral-700">Render As:</dt>
      <dd class="text-body text-neutral-900 sm:col-span-2">
        <code class="px-2 py-1 bg-neutral-100 text-neutral-900 rounded text-caption font-mono">
          <%= rich_text.render_as %>
        </code>
      </dd>
    </div>
  <% end %>
</div>
